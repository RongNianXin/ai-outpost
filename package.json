{
  "name": "ai-outpost",
  "version": "0.5.0",
  "private": true,
  "description": "A low-maintenance AI intelligence briefing for AI application builders.",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "preview:start": "powershell.exe -NoProfile -File scripts/start-preview.ps1",
    "build": "next build && tsx scripts/content/check-downloads.ts",
    "content:check:downloads": "tsx scripts/content/check-downloads.ts",
    "start": "next start",
    "content:validate": "tsx scripts/content/validate.ts",
    "content:check:links": "tsx scripts/content/check-links.ts",
    "content:export:wechat": "tsx scripts/content/export-wechat.ts",
    "content:preview:url": "tsx scripts/content/preview-url.ts",
    "publish:prepare": "tsx scripts/publish/prepare.ts",
    "publish:console": "tsx scripts/publish-console/server.ts",
    "notify:serverchan": "tsx scripts/notify/server-chan.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.9",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.18"
  }
}
